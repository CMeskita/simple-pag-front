@model Helpdesk.Models.Entity.Cliente // Ajuste o namespace para o caminho correto do seu Model de Cliente

@{
    ViewData["Title"] = "Cadastro de Cliente - Helpdesk";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark"><i class="fas fa-user-plus mr-2"></i>Novo Cliente</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Clientes</a></li>
                        <li class="breadcrumb-item active">Cadastro</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">

                    <div class="card card-outline card-info">
                        <div class="card-header">
                            <h3 class="card-title">Informações Corporativas do Cliente</h3>
                        </div>

                        <form asp-action="Add">
                            <div class="card-body">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Nome" class="control-label">Nome do Contato</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                                </div>
                                                <input asp-for="Nome" class="form-control" placeholder="Ex: João Silva" />
                                            </div>
                                            <span asp-validation-for="Nome" class="text-danger text-sm"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Email" class="control-label">E-mail de Contato</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                                </div>
                                                <input asp-for="Email" type="email" class="form-control" placeholder="contato@empresa.com" />
                                            </div>
                                            <span asp-validation-for="Email" class="text-danger text-sm"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Empresa" class="control-label">Razão Social / Empresa</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-industry"></i></span>
                                                </div>
                                                <input asp-for="Empresa" class="form-control" placeholder="Ex: Tech Solutions Ltda" />
                                            </div>
                                            <span asp-validation-for="Empresa" class="text-danger text-sm"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="CodigoEmpresa" class="control-label">CPF / CNPJ</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-industry"></i></span>
                                                </div>
                                                <input asp-for="CodigoEmpresa" class="form-control" placeholder="Ex: Tech Solutions Ltda" />
                                            </div>
                                            <span asp-validation-for="CodigoEmpresa" class="text-danger text-sm"></span>
                                        </div>
                                    </div>
                                </div>

                              <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="custom-control custom-checkbox">
                                            <input asp-for="Lgpd" input type="checkbox" name="lgpd" class="custom-control-input" id="lgpdCheck">
                                            <label class="custom-control-label" for="lgpdCheck">
                                                Declaro que o usuário está ciente e concorda com os <a href="#" class="text-info">Termos de Privacidade e LGPD</a>.
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        
                            <div class="card-footer px-4">
                                <div class="row">
                                    <div class="col-12 col-sm-auto mb-2 mb-sm-0">
                                        <button type="submit" class="btn btn-info px-4 w-100">
                                            <i class="fas fa-save mr-2"></i>Cadastrar Cliente
                                        </button>
                                    </div>

                                    <div class="col d-none d-sm-block"></div>

                                    <div class="col-12 col-sm-auto">
                                        <a asp-action="Index" class="btn btn-default px-4 w-100">
                                            <i class="fas fa-arrow-left mr-2"></i>Voltar para a Lista
                                        </a>
                                    </div>
                                </div>
                            </div>


                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}