@model Helpdesk.Models.Entity.Usuario

@{
    ViewData["Title"] = "Cadastro de Usuário - Helpdesk";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark"><i class="fas fa-user-plus mr-2"></i>Novo Usuário</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Usuários</a></li>
                        <li class="breadcrumb-item active">Cadastro</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">

                    <div class="card card-outline card-info">
                        <div class="card-header">
                            <h3 class="card-title">Informações do Usuário de Suporte</h3>
                        </div>

                        <form asp-action="Add">
                            <div class="card-body">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Nome" class="control-label">Nome Completo</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                                </div>
                                                <input asp-for="Nome" class="form-control" placeholder="Ex: João Silva" />
                                            </div>
                                            <span asp-validation-for="Nome" class="text-danger text-sm"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Email" class="control-label">E-mail Corporativo</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                                </div>
                                                <input asp-for="Email" type="email" class="form-control" placeholder="usuario@empresa.com" />
                                            </div>
                                            <span asp-validation-for="Email" class="text-danger text-sm"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label">Perfil de Acesso (Helpdesk)</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-user-shield"></i></span>
                                                </div>
                                                <select asp-for="Perfil" id="formaPagamento" class="form-control select2 select2-hidden-accessible" style="width: 100%;" data-select2-id="1" tabindex="-1" aria-hidden="true" onchange="atualizarModalidade()">
                                                    <option selected="selected" data-select2-id="3">
                                                        <font style="vertical-align: inherit;">
                                                            <font style="vertical-align: inherit;">(Selecione Perfil)</font>
                                                        </font>
                                                    </option>
                                                    @foreach (var item in ViewBag.Perfil)
                                                    {
                                                        <option value="@item.Nome">
                                                            <font style="vertical-align: inherit;">
                                                                <font style="vertical-align: inherit;"></font>
                                                            </font>@item.Nome
                                                        </option>
                                                    }

                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label">Departamento / Setor</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-building"></i></span>
                                                </div>
                                                <select asp-for="Setor" id="formaPagamento" class="form-control select2 select2-hidden-accessible" style="width: 100%;" data-select2-id="1" tabindex="-1" aria-hidden="true" onchange="atualizarModalidade()">
                                                    <option selected="selected" data-select2-id="3">
                                                        <font style="vertical-align: inherit;">
                                                            <font style="vertical-align: inherit;">(Selecione Setor)</font>
                                                        </font>
                                                    </option>
                                                    @foreach (var item in ViewBag.Setor)
                                                    {
                                                        <option value="@item.Nome">
                                                            <font style="vertical-align: inherit;">
                                                                <font style="vertical-align: inherit;"></font>
                                                            </font>@item.Nome
                                                        </option>
                                                    }

                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="ChavePrivada" class="control-label">Senha de Acesso</label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                                </div>
                                                <input asp-for="ChavePrivada" type="password" class="form-control" placeholder="••••••••" />
                                            </div>
                                            <span asp-validation-for="ChavePrivada" class="text-danger text-sm"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="custom-control custom-checkbox">
                                            <input asp-for="Lgpd" input type="checkbox" name="lgpd" class="custom-control-input" id="lgpdCheck">
                                            <label class="custom-control-label" for="lgpdCheck">
                                                Declaro que o usuário está ciente e concorda com os <a href="#" class="text-info">Termos de Privacidade e LGPD</a>.
                                            </label>
                                        </div>
                                        <span asp-validation-for="Lgpd" class="text-danger text-sm"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer px-4">
                                <div class="row">
                                    <div class="col-12 col-sm-auto mb-2 mb-sm-0">
                                        <button type="submit" class="btn btn-info px-4 w-100">
                                            <i class="fas fa-save mr-2"></i>Cadastrar Usuário
                                        </button>
                                    </div>

                                    <div class="col d-none d-sm-block"></div>

                                    <div class="col-12 col-sm-auto">
                                        <a asp-action="Index" class="btn btn-default px-4 w-100">
                                            <i class="fas fa-arrow-left mr-2"></i>Voltar para a Lista
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}