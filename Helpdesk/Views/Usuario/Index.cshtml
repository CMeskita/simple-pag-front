@model IEnumerable<Helpdesk.Models.Entity.Usuario>

@{
    ViewData["Title"] = "Index";
}




<div class="content-wrapper">
    <!-- Inicio do Header da pagina -->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark"><i class="fas fa-user-alt mr-2"></i>Usuário</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>

                        <li class="breadcrumb-item"><a asp-action="Create">Cadastro</a></li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!-- Inicio do Conteudo -->
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg ">
                    <!-- Inicio do Card -->
                    <div class="card card-info ">
                        <div class="card-header">
                            <h5 class="m-0">Cadastro de Usuário</h5>
                        </div>
                        <div class="card-body ">
                            <div class="row">
                                <div class="col-12">
                                    <div class="table-responsive">
                                        <!-- Inicio do Tabela -->
                                        <table class="table ">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        @Html.DisplayNameFor(model => model.Nome)
                                                    </th>
                                                    <th>
                                                        @Html.DisplayNameFor(model => model.Email)
                                                    </th>

                                                    <th>
                                                        @Html.DisplayNameFor(model => model.Registro)
                                                    </th>

                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.Nome)
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.Email)
                                                        </td>

                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.Registro)
                                                        </td>

                                                        <td class="text-center">
                                                            <div class="btn-group btn-group-sm" role="group">
                                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn" title="Editar">
                                                                    <i class="fas fa-edit"></i>
                                                                </a>

                                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn" title="Detalhes">
                                                                    <i class="fas fa-eye"></i>
                                                                </a>

                                                                <a asp-action="Inativar" asp-route-id="@item.Id" class="btn" title="Inativar/Excluir">
                                                                    <i class="fas fa-trash-alt "></i>
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



